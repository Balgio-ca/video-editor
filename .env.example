# Copier ce fichier en .env et remplir : il est chargé automatiquement par les scripts.
# Seule la ligne du modèle de langue est nécessaire ; tout le reste est facultatif.

# ---------------------------------------------------------------- Modèle de langue (étape édito)
# Choisit les coupes, les sous-titres, le b-roll et l'accroche.
# claude-cli (défaut, abonnement Claude, aucune clé), anthropic, gemini ou openai
LLM_PROVIDER=claude-cli
LLM_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # tout service compatible OpenAI (Ollama, OpenRouter, Mistral, Groq)

# ---------------------------------------------------------------- B-roll de banque
# Vidéos Pexels quand le client n'a pas de plan qui montre ce qui est dit. Clé gratuite : https://www.pexels.com/api/
PEXELS_API_KEY=

# ---------------------------------------------------------------- ElevenLabs : voix off, effets sonores, musique, jingles
# pipeline/generer.py voix | son | musique.  https://elevenlabs.io (Profil > API keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------- OpenAI et Gemini
# Servent à deux choses : l'édito (si LLM_PROVIDER=openai ou gemini) et la génération d'images
# et de vidéos de b-roll (pipeline/generer.py image | video) quand aucun vrai plan ne convient.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Images de b-roll : openai (gpt-image-1) ou gemini (gemini-2.5-flash-image)
IMAGE_PROVIDER=openai
IMAGE_MODEL=
# Vidéos de b-roll : gemini (Veo) ou openai (Sora)
VIDEO_GEN_PROVIDER=gemini
VIDEO_MODEL=

# ---------------------------------------------------------------- Machine (choisis tout seuls)
# VIDEO_ENCODER=x264          # videotoolbox, nvenc ou x264
# WHISPER_BACKEND=faster      # mlx (Mac à puce Apple) ou faster
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=auto         # cuda, cpu ou auto
# HF_GPU=1                    # rendu accéléré par GPU hors Mac
