# Copier ce fichier en .env et remplir : il est chargé automatiquement par les scripts.

# B-roll de banque (gratuit) : https://www.pexels.com/api/
PEXELS_API_KEY=

# Modèle de langue de l'étape édito : claude-cli (défaut), anthropic, gemini ou openai
LLM_PROVIDER=claude-cli
# Modèle précis (facultatif) ; sinon le défaut du fournisseur
LLM_MODEL=

# Selon le fournisseur choisi
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Service compatible OpenAI (facultatif) : Ollama local, OpenRouter, Mistral, Groq...
# OPENAI_BASE_URL=http://localhost:11434/v1

# Machine (facultatif : choisis tout seuls)
# VIDEO_ENCODER=x264          # videotoolbox, nvenc ou x264
# WHISPER_BACKEND=faster      # mlx (Mac à puce Apple) ou faster
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=auto         # cuda, cpu ou auto
# HF_GPU=1                    # rendu accéléré par GPU hors Mac
